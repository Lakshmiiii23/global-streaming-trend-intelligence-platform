# ==============================================================================
# Global Streaming Trend Intelligence Platform - Environment Configuration
# ==============================================================================

# Database Connection (Neon PostgreSQL)
# Example: postgresql://<user>:<password>@<neon-host>.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///data/streaming_intelligence.db

# Storage Configuration (Cloudflare R2)
# Set STORAGE_BACKEND to 'r2' for cloud deployment, or 'local' for local file storage
STORAGE_BACKEND=local
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=streaming-trends-bronze
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=45
SCRAPER_REQUEST_DELAY_SECONDS=3.0

# Ingestion Targets (Comma-separated)
TARGET_PLATFORMS=netflix,amazon-prime,disney,apple-tv,hbo-max
TARGET_COUNTRIES=world,united-states,united-kingdom,india,brazil,japan,germany

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
